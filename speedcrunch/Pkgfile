description="Simple but powerful calculator using Qt"
url="http://speedcrunch.org/"

packager="spiky <spiky@nutyx.org>"
contributors="Greg,Rems,Tnut"

makedepends=(cmake qt6-base qt6-tools)

name=speedcrunch
version=1.1.0

source=(https://github.com/heldercorreia/speedcrunch/archive/refs/tags/v$version.tar.gz)

build() {
cd */src
mkdir -pv build
cd build
cmake .. -DCMAKE_INSTALL_PREFIX=/usr
make
make DESTDIR=$PKG install
}



